# Copy to .env and change every value marked CHANGE.
POSTGRES_DB=smartroad
POSTGRES_USER=smartroad
# Use letters and digits only (it is embedded in a URL).
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Weights file placed in ./models (mounted read-only at /models)
MODEL_FILE=pothole.pt
MIN_CONFIDENCE=0.4
CORS_ORIGINS=http://localhost:8080
